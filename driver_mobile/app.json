{
  "expo": {
    "name": "Falcon Rider Driver",
    "slug": "falcon-rider-driver",
    "scheme": "falconriderdriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.falconrider.driver"
    },
    "android": {
      "package": "com.falconrider.driver"
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
