from django.contrib.auth import password_validation
from django.core.exceptions import ValidationError as DjangoValidationError
from django.db import transaction
from rest_framework import serializers

from .models import User, PassengerProfile, UserRole


class ProviderProfileSerializer(serializers.ModelSerializer):
    capabilities = serializers.SerializerMethodField()
    capability_status = serializers.SerializerMethodField()

    class Meta:
        model = ProviderProfile
        fields = [
            "id",
            "capabilities",
            "capability_status",
            "professional_availability",
            "community_availability",
            "verification_status",
            "created_at",
        ]

    def get_capabilities(self, obj):
        return getattr(obj, "capabilities", []) or []

    def get_capability_status(self, obj):
        return getattr(obj, "capability_status", {}) or {}

class UserSerializer(serializers.ModelSerializer):
    provider_status = serializers.SerializerMethodField()
    provider_profile = serializers.SerializerMethodField()

    class Meta:
        model = User
        fields = [
            "id", "email", "phone_number", "full_name",
            "role", "status", "is_verified",
            "provider_status", "provider_profile", "created_at",
        ]
        read_only_fields = fields

    def get_provider_status(self, obj):
        if obj.role != UserRole.PROVIDER:
            return None
        profile = getattr(obj, "provider_profile", None)
        return profile.verification_status if profile else None

    def get_provider_profile(self, obj):
        if obj.role != UserRole.PROVIDER:
            return None
        profile = getattr(obj, "provider_profile", None)
        if not profile:
            return None
        return ProviderProfileSerializer(profile).data


class UserUpdateSerializer(serializers.ModelSerializer):
    class Meta:
        model = User
        fields = ["full_name", "phone_number"]

    def validate_phone_number(self, value):
        if value in ("", None):
            return None
        value = value.strip()
        digits = value.lstrip("+")
        if not value.startswith("+") or not digits.isdigit() or not (8 <= len(digits) <= 15):
            raise serializers.ValidationError("Enter a valid phone number")
        qs = User.objects.filter(phone_number=value)
        if self.instance:
            qs = qs.exclude(pk=self.instance.pk)
        if qs.exists():
            raise serializers.ValidationError("User with this phone already exists.")
        return value


class RegisterSerializer(serializers.Serializer):
    email = serializers.EmailField(required=False, allow_null=True, allow_blank=True)
    phone_number = serializers.CharField(max_length=20, required=False, allow_null=True, allow_blank=True)
    full_name = serializers.CharField(max_length=150)
    password = serializers.CharField(write_only=True)
    password_confirm = serializers.CharField(write_only=True)

    def validate_email(self, value):
        if not value:
            return None
        value = value.strip().lower()
        if User.objects.filter(email__iexact=value).exists():
            raise serializers.ValidationError("User with this email already exists.")
        return value

    def validate_phone_number(self, value):
        if not value:
            return None
        value = value.strip()
        digits = value.lstrip("+")
        if not value.startswith("+") or not digits.isdigit() or not (8 <= len(digits) <= 15):
            raise serializers.ValidationError("Enter a valid phone number")
        if User.objects.filter(phone_number=value).exists():
            raise serializers.ValidationError("User with this phone already exists.")
        return value

    def validate(self, attrs):
        if not attrs.get("email") and not attrs.get("phone_number"):
            raise serializers.ValidationError(
                {"detail": "Provide either email or phone_number."}
            )
        if attrs["password"] != attrs["password_confirm"]:
            raise serializers.ValidationError(
                {"password_confirm": ["Passwords do not match."]}
            )
        try:
            password_validation.validate_password(attrs["password"])
        except DjangoValidationError as e:
            raise serializers.ValidationError({"password": list(e.messages)})
        return attrs

    @transaction.atomic
    def create(self, validated_data):
        validated_data.pop("password_confirm")
        password = validated_data.pop("password")
        user = User.objects.create_user(
            email=validated_data.get("email"),
            phone_number=validated_data.get("phone_number"),
            full_name=validated_data["full_name"],
            password=password,
            role=UserRole.PASSENGER,
        )
        PassengerProfile.objects.create(user=user)
        return user


class LoginSerializer(serializers.Serializer):
    identifier = serializers.CharField()
    password = serializers.CharField(write_only=True)


class PasswordResetRequestSerializer(serializers.Serializer):
    identifier = serializers.CharField()


class PasswordResetConfirmSerializer(serializers.Serializer):
    identifier = serializers.CharField()
    otp = serializers.CharField(min_length=4, max_length=8)
    new_password = serializers.CharField(write_only=True)
    new_password_confirm = serializers.CharField(write_only=True)

    def validate(self, attrs):
        if attrs["new_password"] != attrs["new_password_confirm"]:
            raise serializers.ValidationError(
                {"new_password_confirm": ["Passwords do not match."]}
            )
        try:
            password_validation.validate_password(attrs["new_password"])
        except DjangoValidationError as e:
            raise serializers.ValidationError({"new_password": list(e.messages)})
        return attrs


class VerifyPhoneSerializer(serializers.Serializer):
    phone_number = serializers.CharField(max_length=20)


class VerifyPhoneConfirmSerializer(serializers.Serializer):
    otp = serializers.CharField(min_length=4, max_length=8)

class ProviderProfileSerializer(serializers.ModelSerializer):
    user_id = serializers.UUIDField(source="user.id", read_only=True)
    email = serializers.EmailField(source="user.email", read_only=True)
    full_name = serializers.CharField(source="user.full_name", read_only=True)

    class Meta:
        from .models import ProviderProfile
        model = ProviderProfile
        fields = [
            "id", "user_id", "email", "full_name",
            "professional_availability", "community_availability",
            "verification_status", "rating", "total_journeys",
            "license_number", "created_at", "updated_at",
        ]
        read_only_fields = [
            "id", "user_id", "email", "full_name",
            "professional_availability", "community_availability",
            "verification_status", "rating", "total_journeys",
            "created_at", "updated_at",
        ]


class ProviderDocumentSerializer(serializers.ModelSerializer):
    provider_id = serializers.UUIDField(source="provider.id", read_only=True)
    file_url = serializers.SerializerMethodField()

    class Meta:
        from .models import ProviderDocument
        model = ProviderDocument
        fields = [
            "id", "provider_id", "document_type", "file_url", "status",
            "reviewed_at", "rejection_reason", "created_at",
        ]
        read_only_fields = [
            "id", "provider_id", "file_url", "status",
            "reviewed_at", "rejection_reason", "created_at",
        ]

    def get_file_url(self, obj):
        if not obj.file:
            return None
        request = self.context.get("request")
        url = obj.file.url
        return request.build_absolute_uri(url) if request else url


class ProviderDocumentUploadSerializer(serializers.Serializer):
    document_type = serializers.ChoiceField(choices=[
        "LICENSE", "INSURANCE", "VEHICLE_REGISTRATION", "IDENTITY",
    ])
    file = serializers.FileField()


class ProviderCapabilitiesUpdateSerializer(serializers.Serializer):
    capabilities = serializers.ListField(
        child=serializers.ChoiceField(choices=[
            "PROFESSIONAL_SERVICE", "COMMUNITY_JOURNEY",
        ]),
        allow_empty=True,
    )


class ProviderAvailabilityUpdateSerializer(serializers.Serializer):
    availability = serializers.ChoiceField(choices=["ONLINE", "OFFLINE", "BUSY"])

